# .env.test
NODE_ENV=test

# Override DB settings for testing
DB_TYPE=sqlite
DB_DATABASE=:memory:
DB_SYNCHRONIZE=true

# RAG (Qdrant + Ollama embedding)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=faq
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_EMBEDDING_DIMENSIONS=1024
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.75
