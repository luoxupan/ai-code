DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=node_server
DB_SYNCHRONIZE=false
PORT=3002
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ygxqqx@163.com
# SMTP_PASSWORD 已移至 .env.development.local（不被 git 追踪）
MAIL_FROM=ygxqqx@163.com

# Agent 会话记忆（LangGraph checkpointer，Redis）
# 多实例（PM2 集群）部署时所有 worker 共享此 Redis，实现跨进程记忆共享
REDIS_URL=redis://localhost:6379
# checkpoint 默认 TTL（分钟），0 = 不过期
REDIS_TTL=0

# RAG (Qdrant + Ollama embedding)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=faq
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_EMBEDDING_DIMENSIONS=1024
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.75
